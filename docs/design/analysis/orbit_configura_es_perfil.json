  "inline_css": [
    "\n    .material-symbols-outlined {\n      font-variation-settings: 'FILL' 0, 'wght' 350, 'GRAD' 0, 'opsz' 20;\n      vertical-align: middle;\n      display: inline-block;\n    }\n    \n    /* Technical subtle scanline & grid effects */\n    .telemetry-grid {\n      background-size: 32px 32px;\n      background-image: \n        linear-gradient(to right, rgba(37, 54, 83, 0.15) 1px, transparent 1px),\n        linear-gradient(to bottom, rgba(37, 54, 83, 0.15) 1px, transparent 1px);\n    }\n\n    .orbital-ring {\n      box-shadow: 0 0 0 1px rgba(68, 226, 205, 0.4), 0 0 20px 2px rgba(118, 146, 255, 0.25);\n    }\n\n    /* Custom toggle switch switch-knob */\n    .toggle-checkbox:checked {\n      right: 2px;\n      left: auto;\n      border-color: #44e2cd;\n    }\n    .toggle-checkbox:checked + .toggle-label {\n      background-color: #7692ff;\n    }\n  "
  ],
