# One installation: personal email/password plus isolated visitor demos. Never commit .env.
APP_MODE=combined
PORT=8080
POSTGRES_PASSWORD=orbit-local-change-me
OIDC_AUTHORITY=
# OIDC fields are optional, for an existing external identity provider only.
OIDC_CLIENT_ID=orbit-web
OIDC_AUDIENCE=orbit-api
OIDC_JWKS_URL=
# HTTP loopback development only. Public deployment must use true and HTTPS.
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080
# Only optional Telegram profile needs real provider credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROVIDER_URL=
TELEGRAM_PROVIDER_KEY=
