{
  "realm": "orbit",
  "enabled": true,
  "displayName": "Orbit Local",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "orbit-web",
      "name": "Orbit Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/auth/callback",
        "http://localhost:5173/auth/callback",
        "http://localhost:8082/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173",
        "http://localhost:8082"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080##http://localhost:5173##http://localhost:8082"
      },
      "protocolMappers": [
        {
          "name": "orbit-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "orbit-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
